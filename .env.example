# ===================== 数据库 =====================
DB_NAME=itam
DB_USER=itam
DB_PASSWORD=change_me_db_password
DB_ROOT_PASSWORD=change_me_root_password

# ===================== 安全 =====================
# 生成方式：openssl rand -hex 32
SECRET_KEY=change_me_generate_with_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===================== 初始管理员 =====================
# 仅首次启动创建账号时生效，登录后请立即修改密码
# 必填：至少 8 位，且同时包含字母和数字
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change_me_admin_password
DEFAULT_ADMIN_NAME=系统管理员

# ===================== 服务 =====================
HTTP_PORT=80
CORS_ORIGINS=http://localhost,http://127.0.0.1:5173
LOG_LEVEL=INFO

# ===================== 资产编号 =====================
ASSET_NO_PREFIX=ITAM
# 可用占位符：{prefix} {year} {month} {seq}
ASSET_NO_PATTERN={prefix}-{year}{month}-{seq:04d}

# ===================== 示例数据 =====================
# 仅用于本地演示/联调：写入示例部门、分类、型号；生产部署保持 false
# 无论该开关如何，均不会写入任何资产、单据或审批实例
SEED_SAMPLE_DATA=false

# ===================== 到期提醒 =====================
# 提醒窗口（天）：保修、合同、借用、盘点
WARRANTY_REMINDER_DAYS=30
CONTRACT_REMINDER_DAYS=30
BORROW_REMINDER_DAYS=3
INVENTORY_REMINDER_DAYS=3
# 邮件提醒通道默认关闭；配置 SMTP 后可开启，收件人多个用逗号分隔
REMINDER_EMAIL_ENABLED=false
REMINDER_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# ===================== 构建镜像源 =====================
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
NPM_REGISTRY=https://registry.npmmirror.com
